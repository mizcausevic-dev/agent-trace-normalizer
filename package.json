{
  "name": "agent-trace-normalizer",
  "version": "0.2.2",
  "description": "Normalize raw LLM provider responses (OpenAI / Anthropic / AWS Bedrock / Google Gemini) into a canonical usage record — the adapter front-end for GenAI cost and tracing pipelines.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizcausevic-dev/agent-trace-normalizer.git"
  },
  "homepage": "https://github.com/mizcausevic-dev/agent-trace-normalizer#readme",
  "bugs": {
    "url": "https://github.com/mizcausevic-dev/agent-trace-normalizer/issues"
  },
  "keywords": [
    "llm",
    "genai",
    "observability",
    "opentelemetry",
    "normalization",
    "adapter",
    "tokens",
    "openai",
    "anthropic"
  ],
  "bin": {
    "agent-normalize": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/responses.jsonl --model bedrock-fallback-model",
    "normalize": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
